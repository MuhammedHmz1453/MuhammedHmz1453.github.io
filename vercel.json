{
  "framework": "jekyll",
  "installCommand": "bundle install",
  "buildCommand": "bundle exec jekyll build",
  "outputDirectory": "_site",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hamzakaraca.vercel.app"
        }
      ],
      "destination": "https://karacadesign.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "muhammedhamzakaraca.vercel.app"
        }
      ],
      "destination": "https://karacadesign.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mhkaraca.vercel.app"
        }
      ],
      "destination": "https://karacadesign.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/surum.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/((?!.*\\.).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
